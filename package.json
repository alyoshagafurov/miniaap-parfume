{
  "name": "arumi",
  "version": "0.1.0",
  "private": true,
  "description": "ÁRUMI Parfum & Care — wholesale catalog: Telegram Mini App, storefront and admin",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port ${PORT:-3100}",
    "bot": "tsx src/bot/index.ts",
    "bot:dev": "tsx watch src/bot/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:bulk": "tsx prisma/seed.ts --bulk",
    "search:reindex": "tsx scripts/reindex-search.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:tokens && pnpm check:bot-boundary && pnpm check:client-boundary && pnpm check:catalog-writes && pnpm check:action-guards && pnpm check:build-io && pnpm test",
    "bench:search": "tsx scripts/bench-search.ts",
    "seed:clear": "tsx scripts/seed-clear.ts",
    "check:bot-boundary": "node scripts/check-bot-boundary.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm check:tokens && pnpm check:bot-boundary && pnpm check:client-boundary && pnpm check:catalog-writes && pnpm check:action-guards && pnpm test && pnpm build",
    "relay:stub": "node scripts/relay-stub.mjs",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:catalog-writes": "node scripts/check-catalog-writes.mjs",
    "check:action-guards": "node scripts/check-action-guards.mjs",
    "check:build-io": "node scripts/check-build-io.mjs",
    "brand:banner": "tsx scripts/make-bot-banner.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "db:create-ru": "tsx scripts/create-search-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@hookform/resolvers": "^5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "9.2.4",
    "@tma.js/init-data-node": "2.0.8",
    "@tma.js/sdk-react": "3.0.23",
    "argon2": "0.45.1",
    "csv-parse": "7.0.2",
    "fflate": "0.8.3",
    "grammy": "1.46.0",
    "iconv-lite": "0.7.3",
    "ioredis": "6.0.0",
    "motion": "13.4.1",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "read-excel-file": "9.3.10",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "write-excel-file": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "railway": "3.11.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vitest": "5.0.1"
  }
}
