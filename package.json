{
  "name": "arumi",
  "version": "0.1.0",
  "private": true,
  "description": "ÁRUMI Parfum & Care — wholesale catalog: Telegram Mini App, storefront and admin",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "bot": "tsx src/bot/index.ts",
    "bot:dev": "tsx watch src/bot/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:bulk": "tsx prisma/seed.ts --bulk",
    "search:reindex": "tsx scripts/reindex-search.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:tokens && pnpm test",
    "bench:search": "tsx scripts/bench-search.ts",
    "seed:clear": "tsx scripts/seed-clear.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@hookform/resolvers": "^5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "9.2.4",
    "@telegram-apps/sdk-react": "3.3.9",
    "@tma.js/init-data-node": "2.0.8",
    "argon2": "0.45.1",
    "grammy": "1.46.0",
    "ioredis": "6.0.0",
    "motion": "13.4.1",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vitest": "5.0.1"
  }
}
