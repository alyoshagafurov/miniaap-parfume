# Caddy на основном сервере: HTTPS и единственная дверь внутрь.
#
# Сертификат выпускается и продлевается автоматически, поэтому настраивать
# здесь нечего — но домен обязан резолвиться в этот сервер ДО первого запуска,
# иначе ACME не пройдёт проверку и Caddy будет повторять её по нарастающей
# паузе. Проверьте `dig +short $DOMAIN` перед `up`.

{
	email {$ACME_EMAIL}
	# Логи в stdout: их собирает docker, у которого настроена ротация.
	# Отдельный файл внутри контейнера рос бы мимо неё.
	log {
		output stdout
		format console
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Приложение целиком. Отдельных правил для /admin нет намеренно: доступ
	# туда решается сессией и ролью в самом приложении, а не тем, кто дошёл до
	# порта — полагаться на прокси в вопросе прав означало бы иметь две
	# несогласуемые модели доступа.
	reverse_proxy web:3000 {
		# Next не санитизирует x-forwarded-for: значение, пришедшее снаружи,
		# доезжает до приложения как есть. Лимит заявок и лимит входа считают
		# по адресу, поэтому клиент, подставивший себе заголовок, обходит оба.
		# Caddy перезаписывает его собственным адресом соединения, и
		# TRUSTED_PROXY_HOPS=1 говорит приложению читать именно последний
		# переход.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	# Статика Next неизменяема по содержимому хэша в имени.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Заголовки безопасности ставит приложение (next.config.ts) — здесь их
	# намеренно нет. Два источника одних и тех же заголовков означают, что
	# однажды они разойдутся и никто не будет знать, какой из них действует.
}
