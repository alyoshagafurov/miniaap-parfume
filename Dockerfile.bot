# ─────────────────────────────────────────────────────────────────────────────
# Процесс бота ÁRUMI.
#
# Отдельный образ, а не второй CMD в том же: у бота другой жизненный цикл
# (long polling, не запрос-ответ), другой профиль перезапуска и другая проверка
# здоровья. И — принципиально — он не должен уметь импортировать next/*: это
# охраняется правилом eslint и smoke-тестом, и отдельный образ делает границу
# физической, а не только договорной.
#
# Здесь нет standalone-сборки: бот запускается через tsx прямо из исходников,
# как и локально. Собирать его отдельным бандлом значило бы завести второй
# способ его запустить — и второй способ ошибиться.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# openssl — для Prisma; libc6-compat — для пакетов, собранных под glibc-ABI.
RUN apk add --no-cache openssl libc6-compat && corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM base AS runner
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json ./
COPY src ./src

RUN pnpm prisma generate

# Файл пульса пишется сюда; healthcheck читает его возраст. Каталог создаётся
# заранее и отдаётся `node`, потому что процесс работает не от root.
RUN mkdir -p /run/arumi && chown node:node /run/arumi
ENV BOT_HEARTBEAT_FILE=/run/arumi/bot-alive

USER node

CMD ["pnpm", "bot"]
