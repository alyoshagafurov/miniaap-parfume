# ─────────────────────────────────────────────────────────────────────────────
# Релей Bot API. Ставится на ЗАРУБЕЖНОМ VPS, не на основном.
#
# Зачем он вообще: api.telegram.org с российских хостингов недоступен. Всё, что
# приложение и бот отправляют в Telegram, идёт через TELEGRAM_API_ROOT, и в
# продакшене это адрес этой машины. Без релея не работает ничего: ни
# приветствие, ни уведомление менеджеру о заявке, ни второй фактор входа в
# админку — код входа отправляется ботом.
#
# ── Две формы, а не одна ──
#
# Bot API живёт по двум разным путям, и проксировать нужно ОБА:
#
#   /bot<token>/<method>          — вызовы методов (sendMessage, getMe, …)
#   /file/bot<token>/<file_path>  — скачивание файлов
#
# apiRoot в grammY подменяет только первый. Релей, умеющий лишь методы,
# выглядит работающим ровно до первой попытки скачать присланное фото — и
# ломается в тот момент, когда никто уже не связывает это с релеем.
# Локальная заглушка scripts/relay-stub.mjs отвечает на обе формы намеренно,
# чтобы неполный релей отличался от неё сразу.
#
# ── Кого пускать ──
#
# Только IP основного сервера. В URL Bot API лежит токен бота: открытый релей —
# это открытый прокси, через который посторонний шлёт сообщения от имени вашего
# бота, если токен где-то утёк. Список адресов задаётся в relay/.env как
# ALLOWED_IP.
#
#   docker run -d --name arumi-relay --restart unless-stopped \
#     -p 80:80 -p 443:443 \
#     -e DOMAIN=relay.example.com -e ACME_EMAIL=you@example.com \
#     -e ALLOWED_IP=203.0.113.10 \
#     -v $PWD/Caddyfile:/etc/caddy/Caddyfile:ro \
#     -v arumi-relay-data:/data \
#     caddy:2-alpine
# ─────────────────────────────────────────────────────────────────────────────

{
	email {$ACME_EMAIL}
	log {
		output stdout
		format console
	}
}

{$DOMAIN} {
	# Разрешён ровно один источник — основной сервер.
	@allowed client_ip {$ALLOWED_IP}

	# Всё остальное получает 403 и ничего не узнаёт о том, что здесь стоит.
	# Именно 403, а не 404: сервер, отвечающий 404 на всё, тоже заметен, а
	# отличать «не пущу» от «нет такого» посторонним незачем.
	handle {
		respond 403
	}

	handle @allowed {
		# Вызовы методов.
		handle /bot* {
			reverse_proxy https://api.telegram.org {
				header_up Host api.telegram.org
			}
		}

		# Скачивание файлов — вторая форма, без которой релей неполон.
		handle /file/bot* {
			reverse_proxy https://api.telegram.org {
				header_up Host api.telegram.org
			}
		}

		# Больше здесь ничего нет. Никакого корневого ответа, никакой страницы
		# статуса: релей не должен подтверждать собственное существование.
		handle {
			respond 404
		}
	}
}
