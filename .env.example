# ÁRUMI Parfum & Care — environment
#
# Copy to .env and fill in. Nothing here has a safe default for production:
# every secret must be generated per environment. .env* is git-ignored.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# PORTS ARE LOCAL-DEVELOPMENT ONLY
#
# 3100 / 5434 / 6381 / 9100 are used because 3000, 5432, 6379 and 9000 are all
# occupied by other projects on this developer machine. They are NOT part of the
# deployment design and must NOT be carried into the stage-3 production configs,
# where the standard ports apply and nothing is published to the host anyway.
# ─────────────────────────────────────────────────────────────────────────────
#
# ─────────────────────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────────────────────

# From @BotFather. Also used to verify Mini App initData signatures, so the web
# app and the bot process must be given the same value.
BOT_TOKEN=

# Bot username without the @. Optional, and unset in production on purpose.
# Only the web service reads it: with it, «Поделиться» on a product page links
# to t.me/<BOT_USERNAME>?start=p_<slug>, and /start points the catalog button
# at that product. Without it the link is the product's own storefront address,
# which opens the product in or out of Telegram.
BOT_USERNAME=

# Bot API endpoint. On Railway it stays at the default: the bot reaches
# api.telegram.org directly. Only the Russian-VPS fallback needs it pointed at
# the relay outside Russia, because api.telegram.org is blocked from Russian
# hosting. Every Bot API call in this codebase honours it — see
# src/server/telegram.
TELEGRAM_API_ROOT=https://api.telegram.org

# Telegram chat that receives new order notifications. The web service sends
# them; the bot only has it so `pnpm deploy:check`, which runs there, can see
# it. A person's private chat id is their Telegram ID; a group chat id is
# negative (e.g. -1001234567890). Either is obtained by sending the bot /id —
# in a group, /id@<bot username>, which reaches the bot whatever the group's
# privacy setting. The recipient must have pressed /start first: a bot cannot
# write to someone who never wrote to it.
ADMIN_CHAT_ID=

# Public HTTPS origin of the Mini App. The bot points its menu button and its
# catalog buttons at it on every start, so nothing is registered in BotFather.
# Locally this is an HTTPS tunnel to the dev server; Telegram will not open a
# plain-http URL.
MINI_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Port 5434, not 5432: docker-compose deliberately avoids the default so it
# cannot collide with a PostgreSQL already installed on the host.
DATABASE_URL=postgresql://arumi:arumi_dev_password@localhost:5434/arumi?schema=public

# Consumed by docker-compose when it initialises the postgres container.
POSTGRES_USER=arumi
POSTGRES_PASSWORD=arumi_dev_password
POSTGRES_DB=arumi
POSTGRES_PORT=5434

# ─────────────────────────────────────────────────────────────────────────────
# Redis — rate limits and one-time admin login codes
# ─────────────────────────────────────────────────────────────────────────────

# Port 6381, not 6379, for the same reason as PostgreSQL above.
REDIS_URL=redis://localhost:6381
REDIS_PORT=6381

# ─────────────────────────────────────────────────────────────────────────────
# Object storage (S3-compatible; MinIO locally, a Russian S3 provider in prod)
# ─────────────────────────────────────────────────────────────────────────────

S3_ENDPOINT=http://localhost:9100
S3_BUCKET=arumi
S3_ACCESS_KEY=arumi_dev_access
S3_SECRET_KEY=arumi_dev_secret

# Origin images are served from. With MinIO this is the endpoint plus bucket;
# in production it is the CDN or bucket public URL.
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9100/arumi

# Host ports for the MinIO container (9000/9001 are commonly taken).
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ─────────────────────────────────────────────────────────────────────────────
# Application secrets
# ─────────────────────────────────────────────────────────────────────────────

# Signs admin session cookies. Generate with:  openssl rand -base64 32
# At least 32 characters: the bot checks the length at boot and refuses to
# start without it, so give web and bot the same value. Rotating it logs every
# administrator out once and breaks nothing else — do it whenever the value has
# been pasted anywhere but the host's variables.
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Local development
# ─────────────────────────────────────────────────────────────────────────────

# Port 3100, not 3000, to avoid whatever else is already serving on this
# machine. Keep MINI_APP_URL pointing at the tunnel, not at this.
PORT=3100

# ── Proxy ─────────────────────────────────────────────────────────────────────
# How many proxies APPEND to x-forwarded-for between the client and this
# process. Only consulted when X-Real-IP is absent.
#
# The relay must set one of the two, and the choice matters: the naive reading
# of x-forwarded-for — its leftmost value — is the client's to forge under
# nginx's own documented `$proxy_add_x_forwarded_for`, and every IP rate limit
# in this application then silently stops working.
#
#   proxy_set_header X-Real-IP $remote_addr;     # preferred — nothing to count
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # then set hops
TRUSTED_PROXY_HOPS=1

# Вход в админку: нужен ли код из Telegram вдобавок к паролю.
#
# По умолчанию нужен — браузер не доказывает, кто за ним сидит, и вторым
# фактором служит Telegram-аккаунт, который у администратора и так есть.
# ADMIN_LOGIN_REQUIRE_CODE=0 оставляет только пароль. Тогда этот пароль —
# всё, что защищает цены, публикацию товаров и заявки с именем и телефоном
# покупателя. Вход через кнопку в боте от этого не меняется: там личность
# подтверждена подписью.
ADMIN_LOGIN_REQUIRE_CODE=1

# Strict-Transport-Security. Read by next.config.ts inside headers(), which
# Next evaluates during `next build`, so it is a build-time value: the
# Dockerfile takes it as an ARG, and changing it takes a new build of web, not
# a restart. On Railway "1" from the start, since the platform owns HTTPS; on a
# VPS only once HTTPS is working and checked — a browser remembers it for a
# year. Leave empty locally.
ENABLE_HSTS=
