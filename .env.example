# ÁRUMI Parfum & Care — environment
#
# Copy to .env and fill in. Nothing here has a safe default for production:
# every secret must be generated per environment. .env* is git-ignored.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────────────────────

# From @BotFather. Also used to verify Mini App initData signatures, so the web
# app and the bot process must be given the same value.
BOT_TOKEN=

# Bot username without the @. Used to build share links: t.me/<BOT_USERNAME>?startapp=p_<slug>
BOT_USERNAME=

# Bot API endpoint. api.telegram.org is blocked from Russian hosting, so in
# production this points at the relay VPS outside Russia (stage 3). Locally,
# leave the default. Every Bot API call in this codebase honours it — see
# src/server/telegram.
TELEGRAM_API_ROOT=https://api.telegram.org

# Telegram chat that receives new order notifications. A group chat id is
# negative (e.g. -1001234567890); get it by adding the bot to the chat.
ADMIN_CHAT_ID=

# Public HTTPS origin of the Mini App, registered with BotFather as the web_app
# URL. Locally this is an HTTPS tunnel to the dev server; Telegram will not open
# a plain-http URL.
MINI_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Port 5434, not 5432: docker-compose deliberately avoids the default so it
# cannot collide with a PostgreSQL already installed on the host.
DATABASE_URL=postgresql://arumi:arumi_dev_password@localhost:5434/arumi?schema=public

# Consumed by docker-compose when it initialises the postgres container.
POSTGRES_USER=arumi
POSTGRES_PASSWORD=arumi_dev_password
POSTGRES_DB=arumi
POSTGRES_PORT=5434

# ─────────────────────────────────────────────────────────────────────────────
# Redis — rate limits and one-time admin login codes
# ─────────────────────────────────────────────────────────────────────────────

# Port 6381, not 6379, for the same reason as PostgreSQL above.
REDIS_URL=redis://localhost:6381
REDIS_PORT=6381

# ─────────────────────────────────────────────────────────────────────────────
# Object storage (S3-compatible; MinIO locally, a Russian S3 provider in prod)
# ─────────────────────────────────────────────────────────────────────────────

S3_ENDPOINT=http://localhost:9100
S3_BUCKET=arumi
S3_ACCESS_KEY=arumi_dev_access
S3_SECRET_KEY=arumi_dev_secret

# Origin images are served from. With MinIO this is the endpoint plus bucket;
# in production it is the CDN or bucket public URL.
S3_PUBLIC_URL=http://localhost:9100/arumi

# Host ports for the MinIO container (9000/9001 are commonly taken).
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ─────────────────────────────────────────────────────────────────────────────
# Application secrets
# ─────────────────────────────────────────────────────────────────────────────

# Signs admin session cookies. Generate with:  openssl rand -base64 32
# Rotating it logs every administrator out.
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Local development
# ─────────────────────────────────────────────────────────────────────────────

# Port 3100, not 3000, to avoid whatever else is already serving on this
# machine. Keep MINI_APP_URL pointing at the tunnel, not at this.
PORT=3100
